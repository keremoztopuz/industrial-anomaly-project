# Copy this file to .env for local work: cp .env.example .env
# .env is ignored by Git and Docker. Real environment variables override it, and command
# line flags override both. The project has no secrets, so nothing here is sensitive.

# Where the banks and the data live
MODEL_DIR=artifacts/border-exclusion/coreset-16384-n3-b2/patchcore
DATASET_ROOT=data/mvtec-ad
ARTIFACTS_ROOT=artifacts

# Which model is meant, and the registry it is tracked in
MODEL_NAME=patchcore-mvtec
MODEL_VERSION=local
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# The API server and its upload limits
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=16000000
MAX_REQUEST_BYTES=11534336

# Where the service is deployed
GCP_PROJECT=industrial-anomaly-510523
GCP_REGION=europe-west1
MODEL_BUCKET=anomaly-api
SERVICE_NAME=anomaly-api
DRIFT_JOB_NAME=drift-check

# Only the drift job needs these (set on the Cloud Run Job by deploy_model)
# DRIFT_REFERENCE=/models/patchcore-mvtec/v2/drift_reference.json
# LOOKBACK_DAYS=30
